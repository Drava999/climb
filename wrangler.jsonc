{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "climb",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Per-visitor limit on Claude requests: 20 per minute per IP address (per Cloudflare location).
  "ratelimits": [
    {
      "name": "RL_BURST",
      "namespace_id": "4201",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RL_LOG",
      "namespace_id": "4202",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Logs of every Claude generation and learner interaction, used to refine the content.
  "d1_databases": [
    { "binding": "LOGS", "database_name": "climb-logs", "database_id": "5e5301bc-1be2-49c8-9904-eec6d78d4ecc" }
  ],
  // Public Google OAuth client ID (not a secret). GOOGLE_CLIENT_SECRET is set as a Worker secret in the dashboard.
  "vars": { "GOOGLE_CLIENT_ID": "851794840006-439b29ol7ngaicjm0ojtpc97ko6g8eec.apps.googleusercontent.com" },
  // Run the server near Singapore. Anthropic's API rejects requests sent from some regions (e.g. Hong Kong),
  // which happened when Cloudflare served Singapore users from its Hong Kong data centre.
  "placement": { "region": "aws:ap-southeast-1" },
  "observability": { "enabled": true }
}
